module full_adder ( 
input A,  
input B,  
input Cin,  
   
 
    output Sum,  
    output Cout 
); 
    assign Sum = A ^ B ^ Cin; 
    assign Cout = (A & B) | (B & Cin) | (A & Cin); 
endmodule 
 
Testbench for Full Adder 
module testbench; 
    reg A, B, Cin; 
    wire Sum, Cout; 
 
    full_adder uut (A, B, Cin, Sum, Cout); 
 
    initial begin 
        $monitor("A = %b, B = %b, Cin = %b | Sum = %b, Cout = %b", A, 
B, Cin, Sum, Cout); 
         
        A = 0; B = 0; Cin = 0; #10; 
        A = 0; B = 0; Cin = 1; #10; 
        A = 0; B = 1; Cin = 0; #10; 
        A = 0; B = 1; Cin = 1; #10; 
        A = 1; B = 0; Cin = 0; #10; 
        A = 1; B = 0; Cin = 1; #10; 
        A = 1; B = 1; Cin = 0; #10; 
        A = 1; B = 1; Cin = 1; #10; 
 
        $finish; 
    end 
endmodule
