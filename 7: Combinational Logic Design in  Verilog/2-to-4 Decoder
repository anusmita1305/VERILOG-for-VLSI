module decoder2to4 ( 
    input [1:0] sel,  
    output reg [3:0] Y 
); 
    always @(*) begin 
        case (sel) 
            2'b00: Y = 4'b0001; 
            2'b01: Y = 4'b0010; 
            2'b10: Y = 4'b0100; 
            2'b11: Y = 4'b1000; 
        endcase 
    end 
endmodule 

Testbench

module tb_decoder2to4;

    reg [1:0] sel;
    wire [3:0] Y;

    // Instantiate DUT
    decoder2to4 dut (
        .sel(sel),
        .Y(Y)
    );

    initial begin
        // Display output
        $monitor("Time = %0t | sel = %b | Y = %b", $time, sel, Y);

        // Test all input combinations
        sel = 2'b00; #10;
        sel = 2'b01; #10;
        sel = 2'b10; #10;
        sel = 2'b11; #10;

        $finish;
    end

endmodule
